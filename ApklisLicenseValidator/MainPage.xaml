<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ApklisLicenseValidator.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False">
    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Margin="0,20,0,0"
                Padding="20"
                Spacing="20">

                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="Apklis License Validator" />

                <!--  Sección Verificar Licencia  -->
                <Border
                    Padding="15"
                    BackgroundColor="#F0F8FF"
                    Stroke="#0078D7"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="Consultar Licencia" />

                        <Entry
                            x:Name="PackageIdEntry"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="18"
                            HorizontalOptions="Fill"
                            Placeholder="Ingrese Package ID" />

                        <Button
                            x:Name="CheckLicenseButton"
                            BackgroundColor="#0078D7"
                            Clicked="OnCheckLicenseClicked"
                            FontSize="18"
                            HorizontalOptions="Fill"
                            Text="Verificar Licencia"
                            TextColor="White" />

                        <!--  Resultado OK  -->
                        <Border
                            x:Name="fOk"
                            Padding="10"
                            BackgroundColor="#E7F4FF"
                            IsVisible="False"
                            Stroke="#0078D7"
                            StrokeShape="RoundRectangle 8">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="Información de Licencia" />

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Usuario:" />
                                    <Label
                                        x:Name="UsernameLabel"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="-" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Licencia:" />
                                    <Label
                                        x:Name="LicenseLabel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="-" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Pagada:" />
                                    <Label
                                        x:Name="PaidLabel"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="-" />

                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Expira:" />
                                    <Label
                                        x:Name="ExpireInLabel"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="-" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <!--  Error General  -->
                        <Border
                            x:Name="fError"
                            Padding="10"
                            BackgroundColor="#FFE5E5"
                            IsVisible="False"
                            Stroke="#D32F2F"
                            StrokeShape="RoundRectangle 8">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="Error" />

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Usuario:" />
                                    <Label
                                        x:Name="EUsernameLabel"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="-" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Error:" />
                                    <Label
                                        x:Name="ErorLabel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="-" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Sección Pagar Licencia  -->
                <Border
                    Padding="15"
                    BackgroundColor="#F0F8FF"
                    Stroke="#0078D7"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="Pagar Licencia" />

                        <Entry
                            x:Name="LicenseIdToPayEntry"
                            ClearButtonVisibility="WhileEditing"
                            FontSize="18"
                            HorizontalOptions="Fill"
                            Placeholder="Ingrese ID de licencia" />

                        <Button
                            x:Name="PayLicenseButton"
                            BackgroundColor="#0078D7"
                            Clicked="OnPayLicenseClicked"
                            FontSize="18"
                            HorizontalOptions="Fill"
                            Text="Pagar"
                            TextColor="White" />

                        <!--  Error Pago  -->
                        <Border
                            x:Name="fPError"
                            Padding="10"
                            BackgroundColor="#FFE5E5"
                            IsVisible="False"
                            Stroke="#D32F2F"
                            StrokeShape="RoundRectangle 8">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="Error de Pago" />

                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Usuario:" />
                                    <Label
                                        x:Name="PEUsernameLabel"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="-" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="Error:" />
                                    <Label
                                        x:Name="PErorLabel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="-" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!--  Sección Para mostrar QR  -->
                <Image x:Name="QrImage" />
                
            </VerticalStackLayout>
        </ScrollView>
        <!--  Overlay para Loading  -->
        <Grid
            x:Name="LoadingOverlay"
            BackgroundColor="#80000000"
            IsVisible="False">
            <ActivityIndicator
                x:Name="GlobalLoadingIndicator"
                HeightRequest="60"
                HorizontalOptions="Center"
                IsRunning="True"
                VerticalOptions="Center"
                WidthRequest="60"
                Color="#0078D7" />
        </Grid>
    </Grid>
</ContentPage>
